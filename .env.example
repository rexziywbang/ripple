# Copy to .env.local (web) / export in the worker's shell. Everything is optional: with no variables set,
# Ripple runs fully in demo mode with simulated Dropbox, Gmail and invitation providers and deterministic
# "Demo reasoning" interpretation.

# SQLite file shared by the web app and the worker (default: data/ripple.db).
# DATABASE_PATH=data/ripple.db

# --- Model reasoning (interpretation, evidence reading, drafting) -------------------------------------
# Any OpenAI-compatible chat-completions endpoint with JSON-schema response_format. When unset, or when
# the call fails, the deterministic fallback is used and labelled "Demo reasoning" in the UI.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_MS=20000

# --- Live Gmail (outbound send only; fixture .example addresses are always refused) ------------------
# Requires an OAuth client with the gmail.send + gmail.readonly scopes and a refresh token for the sender.
# Also switch the project's Gmail connection to "live" in Demo controls.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM_ADDRESS=organizer@example.com

# --- Live Dropbox (files/upload in update mode, so a changed remote rev is a conflict, not an overwrite)
# DROPBOX_ACCESS_TOKEN=
