# Server-only key. Leave empty for deterministic staged planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_FALLBACK_MODEL=gpt-6-astra
# Reasoning is set in code: high for planning/card rewrites, low for place research.
RIPPLE_AI_SPEND_LIMIT_USD=6
# Set disabled to remove only Ripple's local spending cap. Usage and unknown reservations stay recorded.
# Request timeouts, model-call limits, and bounded retries still apply.
RIPPLE_AI_SPEND_CAP=enabled
# Rehearsal records emails/replies locally, even when Gmail is configured.
# Live uses a connected Gmail API account or the legacy browser executor.
RIPPLE_MAIL_MODE=rehearsal
# Official Gmail API OAuth client (server only); never commit filled credentials.
# Register http://127.0.0.1:8787/api/gmail/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORT=8787
# Optional isolated workspace; defaults to ./data. Restart the API after changes.
# RIPPLE_DATA_DIR=data
